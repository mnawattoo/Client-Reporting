DATABASE_URL="postgresql://reportly:reportly@localhost:5432/reportly?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Encrypts OAuth tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Google (Ads / GA4 / Search Console / Business Profile) ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Redirect URI: {APP_BASE_URL}/api/integrations/google/callback
# Enable: Google Ads API, Google Analytics Data API, Search Console API, Business Profile Performance API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=""

# --- Meta (Facebook / Instagram Ads) ---
# developers.facebook.com -> your app -> Marketing API
# Redirect URI: {APP_BASE_URL}/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""

APP_BASE_URL="http://localhost:3000"
# Bearer token required on the cron sync endpoint (/api/sync). Name it exactly
# CRON_SECRET and Vercel Cron will send it automatically — see vercel.json.
CRON_SECRET=""

# --- Monthly report email notifications ---
# resend.com API key. Without this set, the monthly sync still runs and
# publishes reports, it just skips sending the notification email.
RESEND_API_KEY=""
EMAIL_FROM="Reportly <onboarding@resend.dev>"
# Where the "your monthly reports are ready" summary email is sent.
REPORT_NOTIFICATION_EMAIL=""

# Used only by `pnpm db:seed`
SEED_OWNER_EMAIL="owner@agency.test"
SEED_OWNER_PASSWORD="changeme123"
SEED_AGENCY_NAME="Demo Agency"
